# PostgreSQL (Supabase connection string)
# Encode special characters in the password (e.g. & → %26)
#
# Prefer the Session/Transaction pooler URL for GitHub Actions (IPv4).
# Direct db.*.supabase.co hosts are often IPv6-only and fail on Actions runners.
# Example pooler format (from Supabase → Database → Connect → Pooler):
# postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram (Telethon)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_CHANNEL=githubtrending
# Path to Telethon session file (without .session extension)
TELEGRAM_SESSION=telegram_scraper

# GitHub public-web enrichment
ENRICH_CONCURRENCY=2
ENRICH_DELAY_SECONDS=1.5
ENRICH_BATCH_SIZE=50
ENRICH_MAX_AGE_HOURS=24

# Ingestion
INGEST_BATCH_SIZE=100
SOURCE_CHANNEL=githubtrending
